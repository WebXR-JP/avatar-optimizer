{
  "name": "@webxr-jp/texture-compression",
  "version": "0.2.0",
  "description": "Texture compression utilities for avatar-optimizer using WebAssembly",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "import": "./dist/index.js"
    },
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "pnpm lint:fix && pnpm typecheck && tsup",
    "build:wasm": "./scripts/build-wasm.sh",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "texture",
    "compression",
    "wasm",
    "webassembly",
    "ktx2",
    "basis",
    "uastc"
  ],
  "author": "HALBY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebXR-JP/avatar-optimizer.git",
    "directory": "packages/texture-compression"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-istanbul": "^4.0.16",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "playwright": "^1.57.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.38.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "neverthrow": "^8.2.0"
  }
}
