{
  "name": "@webxr-jp/avatar-optimizer",
  "version": "0.2.1",
  "description": "3D model optimization library for WebXR applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm lint:fix && pnpm typecheck && tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "vitest run --browser.enabled=true --browser.headless=true --coverage.provider=istanbul",
    "manual:loaders-gl": "tsx __tests__/manual/loaders-gl.manual.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vrm",
    "webxr",
    "optimization",
    "gltf",
    "3d"
  ],
  "author": "HALBY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebXR-JP/avatar-optimizer.git",
    "directory": "packages/avatar-optimizer"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@pixiv/three-vrm": "^3.4.4",
    "@pixiv/three-vrm-materials-mtoon": "^3.4.4",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@types/node": "^24.10.0",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "gltf-validator": "2.0.0-dev.3.10",
    "happy-dom": "^20.0.10",
    "playwright": "^1.57.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.16",
    "vrm-validator": "^2.0.0-dev.3.10"
  },
  "dependencies": {
    "@loaders.gl/core": "^4.3.4",
    "@loaders.gl/gltf": "^4.3.4",
    "@loaders.gl/images": "^4.3.4",
    "@loaders.gl/polyfills": "^4.3.4",
    "@pixiv/three-vrm-core": "^3.4.4",
    "@pixiv/three-vrm-node-constraint": "^3.4.5",
    "@webxr-jp/mtoon-atlas": "workspace:^",
    "@webxr-jp/texture-compression": "workspace:^",
    "canvas": "^3.2.0",
    "jimp": "^1.6.0",
    "meshoptimizer": "^1.0.1",
    "neverthrow": "^8.2.0",
    "rectpack-ts": "^0.0.2"
  }
}
